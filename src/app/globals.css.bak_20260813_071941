@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

/* ── DESIGN TOKENS ── */
:root {
  /* Green SaaS theme */
  color-scheme: light;
  --bg: #F6FAF8;
  --bg-soft: #EEF5F1;
  --card: #FFFFFF;
  --card-hover: #F5FAF7;
  --card-alt: #F1F8F4;
  --text: #0F1F17;
  --text-muted: #4B6357;
  --text-soft: #8CA599;
  --border: #E1EBE5;
  --border-strong: #C9DBD0;
  --primary: #0F9D58;
  --primary-hover: #0B7C44;
  --primary-text: #FFFFFF;
  --success: #16A34A;
  --warning: #F59E0B;
  --danger: #EF4444;
  --shell-bg: #EEF5F1;
  --sidebar-bg: #FFFFFF;
  --sidebar-border: #E1EBE5;
  --topbar-bg: #FFFFFF;
  --topbar-border: #E1EBE5;
  --main-bg: #F6FAF8;
  --shadow-sm: 0 1px 2px rgba(15,157,88,0.05);
  --shadow: 0 1px 3px rgba(15,157,88,0.08);
  --shadow-lg: 0 4px 12px rgba(15,157,88,0.10);
  --radius: 12px;
  --font-family: 'Inter', sans-serif;
}

[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0B1120;
  --bg-soft: #0F172A;
  --card: #111827;
  --card-hover: #1E293B;
  --text: #E2E8F0;
  --text-muted: #94A3B8;
  --text-soft: #64748B;
  --border: #1E293B;
  --border-strong: #334155;
  --primary: #3B82F6;
  --primary-hover: #60A5FA;
  --primary-text: #FFFFFF;
  --success: #34D399;
  --warning: #FBBF24;
  --danger: #F87171;
  --shell-bg: #0B1120;
  --sidebar-bg: #0B1120;
  --sidebar-border: #1E293B;
  --topbar-bg: #0F172A;
  --topbar-border: #1E293B;
  --main-bg: #0B1120;
  --shadow: 0 1px 3px rgba(0,0,0,0.4);
}

/* ── OneAccounts Brand Theme ── */
[data-theme="oneaccounts"] {
  /* OneAccounts theme - expert recommended contrast improvements */
  color-scheme: light;
  --bg: #F7F9FC;
  --bg-soft: #F1F4F8;
  --card: #FFFFFF;
  --card-hover: #F3F6FC;
  --card-alt: #F8FAFC;
  --text: #0F172A;
  --text-muted: #475569;
  --text-soft: #94A3B8;
  --border: #E5E7EB;
  --border-strong: #D1D5DB;
  --primary: #0F9D58;
  --primary-hover: #0B7C44;
  --primary-text: #FFFFFF;
  --success: #16A34A;
  --warning: #F59E0B;
  --danger: #EF4444;
  --shell-bg: #F1F4F8;
  --sidebar-bg: linear-gradient(155deg, #021B0E 0%, #04331A 22%, #085C30 50%, #0B7C44 78%, #0F9D58 100%);
  --sidebar-border: rgba(255,255,255,0.12);
  --topbar-bg: linear-gradient(155deg, #021B0E 0%, #04331A 22%, #085C30 50%, #0B7C44 78%, #0F9D58 100%);
  --topbar-border: transparent;
  --main-bg: #FFFFFF;
  --shadow-sm: 0 1px 2px rgba(15,157,88,0.06);
  --shadow: 0 1px 3px rgba(15,157,88,0.08);
  --shadow-lg: 0 4px 12px rgba(15,157,88,0.12);
}

/* ── GLOBAL RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--font-family);
  background: var(--bg);
  color: var(--text);
  transition: background 0.3s, color 0.3s;
}

/* ── OneAccounts overrides ── */
/* Sidebar – white text */
[data-theme="oneaccounts"] .dl-sidebar,
[data-theme="oneaccounts"] .dl-sidebar a,
[data-theme="oneaccounts"] .dl-sidebar .dl-section-label,
[data-theme="oneaccounts"] .dl-sidebar .dl-nav-group-label,
[data-theme="oneaccounts"] .dl-sidebar .dl-nav-item,
[data-theme="oneaccounts"] .dl-sidebar .dl-nav-item span,
[data-theme="oneaccounts"] .dl-sidebar .dl-sidebar-logo-name,
[data-theme="oneaccounts"] .dl-sidebar .dl-sidebar-logo-sub,
[data-theme="oneaccounts"] .dl-sidebar .dl-sidebar-email,
[data-theme="oneaccounts"] .dl-sidebar .dl-sidebar-signout {
  color: rgba(255,255,255,0.85) !important;
}
[data-theme="oneaccounts"] .dl-sidebar .dl-nav-item:hover {
  background: rgba(255,255,255,0.1) !important; color: #fff !important;
}

/* Top bar – white text */
[data-theme="oneaccounts"] .dl-topbar,
[data-theme="oneaccounts"] .dl-topbar .dl-topbar-title,
[data-theme="oneaccounts"] .dl-topbar .dl-topbar-subtitle { color: white !important; }

/* Dashboard Hero – gradient blue, white text */
[data-theme="oneaccounts"] .mgmt .hero {
  background: linear-gradient(155deg, #04092E 0%, #071352 18%, #0F2280 40%, #1740C8 72%, #1E55E8 100%) !important;
  color: white !important; border-radius: 16px; border: none;
}
[data-theme="oneaccounts"] .mgmt .hero-greeting h2,
[data-theme="oneaccounts"] .mgmt .hero-greeting p { color: white !important; }
[data-theme="oneaccounts"] .mgmt .hero .filter-label,
[data-theme="oneaccounts"] .mgmt .hero .filter-pill { color: rgba(255,255,255,0.9) !important; }
[data-theme="oneaccounts"] .mgmt .hero .filter-pill {
  background: rgba(255,255,255,0.15) !important;
  border: 1px solid rgba(255,255,255,0.3) !important; color: white !important;
}
[data-theme="oneaccounts"] .mgmt .hero .filter-pill:focus { border-color: white !important; }

/* Dashboard KPI cards – subtle blue border */
[data-theme="oneaccounts"] .mgmt .kpi-card {
  border-color: #C7D2FE; box-shadow: 0 1px 3px rgba(23,64,200,0.08);
}

/* ── All other page headers (list views, forms, etc.) – gradient background, white text ──
   Targets direct children of .dl-main-content that use flex with space-between,
   which is exactly the layout of your page headers (title + button).
   This excludes the dashboard hero because it is nested deeper inside .mgmt. */
[data-theme="oneaccounts"] .dl-main-content > div[style*="justify-content: space-between"] {
  background: linear-gradient(155deg, #04092E 0%, #071352 18%, #0F2280 40%, #1740C8 72%, #1E55E8 100%) !important;
  border-radius: 12px;
  padding: 20px 24px;
  margin-bottom: 20px;
}
[data-theme="oneaccounts"] .dl-main-content > div[style*="justify-content: space-between"] h1,
[data-theme="oneaccounts"] .dl-main-content > div[style*="justify-content: space-between"] p {
  color: white !important;
}

/* Global headings (outside the gradient header) – blue */
[data-theme="oneaccounts"] .dl-main-content h1,
[data-theme="oneaccounts"] .dl-main-content h2,
[data-theme="oneaccounts"] .dl-main-content h3 {
  color: #0F9D58;
}