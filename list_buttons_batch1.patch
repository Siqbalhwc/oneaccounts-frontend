diff --git a/src/app/globals.css b/src/app/globals.css
index f41160f9..b5987138 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -243,3 +243,41 @@ body {
   background: var(--bg-soft);
   border: 1px solid var(--border-strong);
 }
+
+
+/* ── STANDARD LIST-PAGE BUTTONS & HEADER (shared; used by the list pages) ── */
+.oa-btn {
+  padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600;
+  line-height: 1.2; font-family: inherit; white-space: nowrap; cursor: pointer;
+  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
+  background: transparent; color: var(--text-muted);
+  border: 1.5px solid var(--border); transition: all 0.2s;
+}
+.oa-btn:hover { background: var(--card-hover); }
+.oa-btn:disabled { opacity: 0.55; cursor: not-allowed; }
+.oa-btn-outline { background: transparent; color: var(--text-muted); border-color: var(--border); }
+.oa-btn.oa-btn-primary {
+  background: var(--primary);
+  background: linear-gradient(135deg, var(--primary) 0%, color-mix(in srgb, var(--primary) 35%, #000) 100%);
+  color: var(--primary-text); border-color: transparent;
+}
+.oa-btn.oa-btn-primary:hover {
+  filter: brightness(1.12); transform: translateY(-1px);
+  box-shadow: 0 6px 20px rgba(7, 19, 82, 0.35);
+}
+.oa-btn.oa-btn-primary:disabled { transform: none; box-shadow: none; filter: none; }
+
+.oa-list-header {
+  display: flex; justify-content: space-between; align-items: center;
+  margin-bottom: 20px; flex-wrap: wrap; gap: 12px;
+}
+.oa-list-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
+
+@media (max-width: 640px) {
+  .oa-list-header { flex-direction: column; align-items: stretch; gap: 12px; }
+  .oa-list-actions { width: 100%; }
+  .oa-list-header > .oa-btn,
+  .oa-list-actions > .oa-btn { flex: 1 1 0; min-height: 40px; }
+  .oa-list-header > .oa-btn.oa-btn-primary { flex: 1 1 100%; }
+  .oa-list-actions > .oa-btn.oa-btn-primary { order: -1; flex: 1 1 100%; }
+}
